# ===================================================
# inmobia360 - AI BROKER (broker.inmobia360.com)
# ===================================================
APP_ENV=production
APP_URL=https://broker.inmobia360.com

# Base de Datos (PostgreSQL 16 con pgvector)
DATABASE_URL=postgresql://broker_user:broker_password@localhost:5432/ai_broker_db

# ===================================================
# Motor de Inteligencia Artificial (Ecosistema inmobia360)
# ===================================================
AI_DEFAULT_PROVIDER=ollama
OLLAMA_URL=https://72.62.27.4/api/chat
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# Respaldos Secundarios (Misma estructura de inmobia360 / captacion-2.0)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Seguridad y Aislamiento Multi-tenant
NEXTAUTH_SECRET=genera_un_secreto_seguro_con_openssl
NEXTAUTH_URL=https://broker.inmobia360.com

# Almacenamiento Privado de Documentos
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/private

# Stripe (Inactivo durante beta gratuita)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
