# ===================================================
# AI BROKER - Variables de Entorno (Plantilla)
# ===================================================

# Base de Datos (PostgreSQL 16 con pgvector)
DATABASE_URL=postgresql://broker_user:broker_password@localhost:5432/ai_broker_db

# Motor de Inteligencia Artificial (Ollama auto-alojado en Hostinger)
OLLAMA_BASE_URL=http://72.62.27.4:11434
OLLAMA_MODEL=llama3.1:8b
# Autenticación Ollama (bearer, basic o none)
OLLAMA_AUTH_TYPE=basic
OLLAMA_AUTH_USER=
OLLAMA_AUTH_PASSWORD=
OLLAMA_AUTH_TOKEN=

# Seguridad y Sesiones
NEXTAUTH_SECRET=genera_un_secreto_seguro_con_openssl
NEXTAUTH_URL=http://localhost:3000

# Almacenamiento Privado de Documentos
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/private

# Stripe (Inactivo durante beta gratuita)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
